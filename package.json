{
  "name": "happy-dev",
  "version": "1.0.0",
  "description": "A private, offline desktop suite of developer utilities.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "kill:5173": "npx --yes kill-port 5173",
    "kill:7200": "npx --yes kill-port 7200",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "update-app": "npm run build && rm -rf /tmp/happydev-asar-staging && mkdir -p /tmp/happydev-asar-staging && cp -R dist dist-electron public package.json /tmp/happydev-asar-staging/ && npx asar pack /tmp/happydev-asar-staging release/1.0.0/mac-arm64/HappyDev.app/Contents/Resources/app.asar",
    "app": "npm run update-app && (pkill -f HappyDev || true) && open release/1.0.0/mac-arm64/HappyDev.app",
    "add-headers": "node scripts/add-headers.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xcoj027/happy-dev.git"
  },
  "keywords": [
    "developer-tools",
    "utility",
    "offline",
    "jwt",
    "diff",
    "crypto",
    "json",
    "sql",
    "formatter",
    "converter",
    "electron"
  ],
  "author": "TNQSW",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "canvas-confetti": "^1.9.4",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql-formatter": "^15.9.0",
    "yaml": "^2.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  }
}
