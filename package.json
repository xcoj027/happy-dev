{
  "name": "happy-dev",
  "version": "1.0.0",
  "description": "A private, offline desktop suite of developer utilities.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.cjs dev",
    "kill:7200": "npx --yes kill-port 7200",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit",
    "clean": "node scripts/clean.cjs",
    "clean:all": "node scripts/clean.cjs --all",
    "preview": "vite preview",
    "update-app": "node scripts/package-tauri.cjs macos --local",
    "app": "node scripts/package-tauri.cjs macos --local --open",
    "add-headers": "node scripts/add-headers.cjs",
    "pack": "node scripts/tauri.cjs build --no-bundle",
    "dist": "node scripts/package-tauri.cjs",
    "dist:mac": "node scripts/package-tauri.cjs macos",
    "dist:win": "node scripts/package-tauri.cjs windows",
    "dist:linux": "node scripts/package-tauri.cjs linux",
    "dev:web": "vite",
    "tauri": "node scripts/tauri.cjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xcoj027/happy-dev.git"
  },
  "keywords": [
    "developer-tools",
    "utility",
    "offline",
    "jwt",
    "diff",
    "crypto",
    "json",
    "sql",
    "formatter",
    "converter",
    "tauri"
  ],
  "author": "TNQSW",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/crypto-js": "^4.2.2",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cron-parser": "^5.10.1",
    "cronstrue": "^3.27.0",
    "crypto-js": "^4.2.0",
    "diff": "^9.0.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sql-formatter": "^15.9.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-notification": "^2.5.1"
  }
}
